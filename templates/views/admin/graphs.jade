
extends ../../layouts/admin.jade

block adminContent
    table.table.table-striped.sbh-datatable
        thead
            tr
                th Graph URI
                th # Triples
        tbody
            each graph in graphs
                tr
                    td
                        code #{graph.graphUri}
                    td.sbh-graph-triple-count(data-graph-uri=graph.graphUri) …

block js
    script.
        (function () {
            $.ajax({
                url: '/admin/graphs',
                dataType: 'json',
                headers: { 'Accept': 'application/json' },
                success: function (graphs) {
                    var byUri = {}
                    graphs.forEach(function (g) {
                        byUri[g.graphUri] = g.numTriples
                    })

                    $('.sbh-graph-triple-count').each(function () {
                        var uri = $(this).attr('data-graph-uri')
                        if (Object.prototype.hasOwnProperty.call(byUri, uri)) {
                            $(this).text(byUri[uri])
                        } else {
                            $(this).text('0')
                        }
                    })

                    if ($.fn.DataTable && $.fn.DataTable.isDataTable('.sbh-datatable')) {
                        $('.sbh-datatable').DataTable().cells('.sbh-graph-triple-count').invalidate().draw(false)
                    }
                },
                error: function () {
                    $('.sbh-graph-triple-count').text('Error')
                }
            })
        })()
