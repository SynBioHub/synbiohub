
extends ../../layouts/admin.jade

block adminContent
    div
        if registerAlert
            div.alert.alert-danger #{registerAlert}
        form.form(method="POST", action="/admin/mail")
            div.form-group
                label(for="key") Resend API Key
                input.form-control#key(name="key", placeholder="re_xxxxxxxx", value=resendApiKey)
            div.form-group
                label(for="fromEmail") Resend From Email
                input.form-control#fromEmail(name="fromEmail", placeholder="From Email", value=fromAddress)
            button.btn.btn-primary.pull-right(type="Submit") Submit
